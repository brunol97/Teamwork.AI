# Custom health check message
PING_MESSAGE=pong

# Auth
# Auth is enabled when AUTH_DISABLED is unset. Standalone production/preview
# deploys need a stable BETTER_AUTH_SECRET.
BETTER_AUTH_SECRET=
# Public URL used for auth callbacks. Required for preview/production.
# Leave unset in local dev to let the framework infer localhost.
# APP_URL=https://agent-office-woad.vercel.app
# AUTH_DISABLED=true
# Tijdelijke e-mailallowlist: alleen deze adressen kunnen zich aanmelden en een
# sessie houden (kommagescheiden). Zonder waarde geldt bruno.lenderink@gmail.com.
# AUTH_ALLOWED_EMAILS=bruno.lenderink@gmail.com

# Database
# Local development uses PGlite by default (data/pglite).
# Preview and production require a persistent PostgreSQL URL.
# DATABASE_URL=postgresql://...

# Supabase — DEV / Preview (o)
NEXT_PUBLIC_SUPABASE_URL=https://ekzshymcaxaeoegleoyo.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_0q6JvqaheIpvTnG0JXHWYw_VUKdrcd2
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — PRODUCTIE (p)
SUPABASE_URL_PROD=https://yzcwmaihkxfubtqatynt.supabase.co
SUPABASE_PUBLISHABLE_KEY_PROD=sb_publishable_4j4UTmyI4A_7CY8PSPYTOA_4Daf2Li5
SUPABASE_SERVICE_ROLE_KEY_PROD=

# Ollama
# Agent Office uses Ollama as its only model provider.
# OLLAMA_BASE_URL is the server ROOT, not an API path: ai-sdk-ollama appends
# /api/chat itself. Use the root for Ollama Cloud, or http://localhost:11434
# for a local Ollama. A trailing /api is tolerated but not recommended.
OLLAMA_BASE_URL=https://ollama.com
OLLAMA_MODEL=gpt-oss:120b
OLLAMA_API_KEY=

# PostHog — project 240155 (EU). The Agent-Native framework reads these names:
# POSTHOG_API_KEY + POSTHOG_HOST   server track()/identify() and server exceptions
# POSTHOG_PUBLIC_KEY + POSTHOG_PUBLIC_HOST   browser exception capture
POSTHOG_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
# The framework also reads POSTHOG_PROJECT_ID; keep it next to the keys.
POSTHOG_PROJECT_ID=240155
POSTHOG_PUBLIC_KEY=
POSTHOG_PUBLIC_HOST=https://eu.i.posthog.com

# Email
# Required for magic-link login. Resend API key and sender address.
RESEND_API_KEY=
BETTER_AUTH_EMAIL_FROM="Agent Office <onboarding@resend.dev>"
